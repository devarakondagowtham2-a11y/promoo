# ===========================
# Promocode Automation Config
# ===========================

# SAFETY GATE — Must be "true" to allow execution
TEST_MODE=true

# Target website URL
WEBSITE_URL=https://o96.app/?utm_ref=1887984572

# Node role: "controller" (Laptop 1) or "worker" (Laptop 2)
NODE_ROLE=controller

# WebSocket settings (for dual-node setup)
WS_PORT=9600
WS_HOST=0.0.0.0
WS_AUTH_TOKEN=change-me-to-a-secure-random-string

# Worker connection (set on Laptop 2 only)
# WS_CONTROLLER_URL=ws://192.168.1.100:9600

# Concurrency: how many browsers open simultaneously (max 10)
MAX_CONCURRENCY=5

# Account range this machine handles (1-indexed)
ACCOUNT_RANGE_START=1
ACCOUNT_RANGE_END=10

# Browser settings
HEADLESS=false
SLOW_MO=50

# Logging
LOG_LEVEL=info

# Telegram Configuration (for gramjs MTProto client)
# Get your API ID and Hash from https://my.telegram.org
TG_API_ID=
TG_API_HASH=
TG_CHANNEL=@odds96_india
TG_SESSION=
